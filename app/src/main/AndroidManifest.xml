<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logoapp_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logoapp_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GymInventory">

        <!-- Actividad principal de la aplicación -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Pantalla de registro -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Pantalla inicial de Login -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"> <!-- Solo esta pantalla en true porque Android necesita poder abrirla desde fuera de la aplicación -->

            <intent-filter> <!-- Indica que es esta es la pantalla inicial -->
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
    </application>

</manifest>