<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base con DayNight para que funcione el cambio automAtico -->
    <style name="Theme.GymInventory" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Color principal -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Color secundario -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Fondo -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Color de la barra de estado -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/purple_500</item>

        <!-- Colores personalizados para el drawer -->
        <item name="drawerSelectedBg">@color/drawer_selected_bg</item>
        <item name="drawerSelectedTextColor">@color/drawer_selected_text</item>
    </style>
</resources>